<Window x:Class="LabSystemApp.Views.PatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/labapp.png"
        Title="Личный кабинет пациента"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed"
        Background="#1C2526">
    <!-- Black background for window -->
    <Grid Background="#1C2526">
        <!-- Black background for grid -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <DockPanel Grid.Row="0" Height="70" Background="#394867" LastChildFill="False" VerticalAlignment="Center">
            <!-- Dark blue header -->
            <Image x:Name="ProfileImage" Width="50" Height="50" Margin="15,10" Stretch="UniformToFill"/>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10,0" Background="#394867">
                <!-- Dark blue -->
                <TextBlock x:Name="FullNameText" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                <!-- White text -->
                <TextBlock x:Name="RoleText" FontSize="12" Foreground="#FFFFFF"/>
                <!-- White text -->
            </StackPanel>
            <Button Content="Выход" DockPanel.Dock="Right" Margin="10" Padding="10,5" Click="BackToMain_Click"
                    Background="#4A6FA5" Foreground="#FFFFFF" BorderBrush="#FFFFFF"/>
            <!-- Blue button, white text -->
        </DockPanel>

        <!-- Основная часть -->
        <Grid Grid.Row="1" Margin="10" Background="#1C2526">
            <!-- Black -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        </Grid>

        <!-- Нижняя панель -->
        <TextBlock Grid.Row="2" HorizontalAlignment="Right" Foreground="#FFFFFF" FontSize="12" Margin="10"> <!-- White text -->
            Режим просмотра анализов
        </TextBlock>
    </Grid>
</Window>
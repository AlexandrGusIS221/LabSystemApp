<Window x:Class="LabSystemApp.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:wpf="http://schemas.scottplot.net/2008/xaml/presentation"
        Icon="/Assets/labapp.png"
        Title="Панель администратора" Height="610" Width="910"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed"
        Background="#1A2223">
    <!-- Slightly darker background -->
    <Grid Background="#1A2223">
        <!-- Matching grid background -->
        <!-- Верхняя панель -->
        <DockPanel Height="65" Background="#355070" LastChildFill="False" VerticalAlignment="Top">
            <!-- Different blue shade -->
            <Image x:Name="ProfileImage" Width="48" Height="48" Margin="12"
                   Source="{Binding UserImage}"/>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Background="#355070">
                <TextBlock x:Name="FullNameText" Foreground="#F0F0F0" FontWeight="Bold" FontSize="15"/>
                <!-- Off-white text -->
                <TextBlock x:Name="RoleText" Foreground="#F0F0F0" FontSize="13"/>
                <!-- Off-white text -->
            </StackPanel>
            <Button Content="Выйти" DockPanel.Dock="Right" Margin="12" Padding="12,6" Click="BackToMain_Click"
                    Background="#4B7BB0" Foreground="#F0F0F0" BorderBrush="#F0F0F0"/>
            <!-- Different blue, off-white text -->
        </DockPanel>

        <!-- Основная часть -->
        <TabControl Margin="12,75,12,12" x:Name="AdminTabs" Background="#1A2223" BorderBrush="#4B7BB0">
            <!-- Matching background -->
            <!-- Пользователи -->
            <TabItem Header="Пользователи">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1A2223">
                    <StackPanel Background="#2A3537">
                        <!-- Different gray -->
                        <StackPanel Orientation="Horizontal" Margin="0,12" HorizontalAlignment="Left" Background="#2A3537">
                            <Label Content="Поиск по логину:" Margin="22,0,6,0" Foreground="#F0F0F0"/>
                            <!-- Off-white text -->
                            <TextBox x:Name="LoginSearchBox" Width="160" TextChanged="LoginSearchBox_TextChanged"
                                     Background="#355070" Foreground="#F0F0F0" BorderBrush="#4B7BB0"/>
                        </StackPanel>

                        <DataGrid x:Name="UsersDataGrid"               
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="#1A2223" Foreground="#F0F0F0" BorderBrush="#4B7BB0" RowBackground="#1A2223" AlternatingRowBackground="#2A3537">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#355070"/>
                                    <Setter Property="Foreground" Value="#F0F0F0"/>
                                    <Setter Property="BorderBrush" Value="#4B7BB0"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding UserID}" Width="50" Foreground="#F0F0F0"/>
                                <DataGridTextColumn Header="Имя" Binding="{Binding FullName}" Width="*" Foreground="#F0F0F0"/>
                                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="160" Foreground="#F0F0F0"/>
                                <DataGridTextColumn Header="Роль" Binding="{Binding Role.Name}" Width="110" Foreground="#F0F0F0"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Добавление сотрудника в систему -->
            <TabItem Header="Новый сотрудник">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1A2223">
                    <StackPanel Margin="22" x:Name="AddEmployeePanel" Background="#2A3537">
                        <TextBlock Text="Полное имя:" Foreground="#F0F0F0"/>
                        <!-- Off-white text -->
                        <TextBox x:Name="EmployeeFullName" Background="#355070" Foreground="#F0F0F0" BorderBrush="#4B7BB0"/>

                        <TextBlock Text="Роль:" Foreground="#F0F0F0"/>
                        <ComboBox x:Name="EmployeeRoleCombo" 
                                  DisplayMemberPath="Name" 
                                  SelectedValuePath="RoleID"
                                  Background="#355070" Foreground="#000000" BorderBrush="#4B7BB0"/>

                        <TextBlock Text="Номер телефона:" Foreground="#F0F0F0"/>
                        <TextBox x:Name="EmployeePhone" Background="#355070" Foreground="#F0F0F0" BorderBrush="#4B7BB0"/>

                        <TextBlock Text="Эл. почта:" Foreground="#F0F0F0"/>
                        <TextBox x:Name="EmployeeEmail" Background="#355070" Foreground="#F0F0F0" BorderBrush="#4B7BB0"/>

                        <TextBlock Text="Логин:" Foreground="#F0F0F0"/>
                        <TextBox x:Name="EmployeeLogin" Background="#355070" Foreground="#F0F0F0" BorderBrush="#4B7BB0"/>

                        <TextBlock Text="Пароль:" Foreground="#F0F0F0"/>
                        <PasswordBox x:Name="EmployeePassword" Background="#355070" Foreground="#F0F0F0" BorderBrush="#4B7BB0"/>

                        <TextBlock x:Name="EmployeeErrorText" Foreground="#FF4040" Margin="6"/>
                        <!-- Brighter red -->

                        <!-- Выбор изображения -->
                        <TextBlock Text="Изображение профиля:" Foreground="#F0F0F0"/>
                        <StackPanel Orientation="Horizontal" Background="#2A3537">
                            <Image x:Name="EmployeePreviewImage" Width="98" Height="98" Margin="0,0,12,0"
                                   Source="/Assets/default.gif" Stretch="UniformToFill"/>
                            <Button Content="Загрузить фото" Click="SelectEmployeeImage_Click" Height="26"
                                    Background="#4B7BB0" Foreground="#F0F0F0" BorderBrush="#F0F0F0"/>
                        </StackPanel>
                        <TextBlock x:Name="ImagePathText" FontSize="11" Foreground="#F0F0F0"/>
                        <!-- Off-white text -->

                        <Button Content="Зарегистрировать сотрудника" Margin="0,22,0,0" Click="CreateEmployee_Click"
                                Background="#4B7BB0" Foreground="#F0F0F0" BorderBrush="#F0F0F0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- История входов -->
            <TabItem Header="Логи входов">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1A2223">
                    <StackPanel Margin="12" Background="#2A3537">
                        <StackPanel Orientation="Horizontal" Margin="0,12" Background="#2A3537">
                            <Label Content="Фильтр по логину:" Margin="0,0,6,0" Foreground="#F0F0F0"/>
                            <TextBox x:Name="HistoryLoginSearchBox" Width="160" TextChanged="FilterChanged"
                                     Background="#355070" Foreground="#F0F0F0" BorderBrush="#4B7BB0"/>

                            <TextBlock Text="С:" VerticalAlignment="Center" Margin="110,0,6,0" Foreground="#F0F0F0"/>
                            <DatePicker x:Name="StartDatePicker" Width="130" Margin="0,0,18,0" SelectedDateChanged="FilterChanged"
                                        Background="#355070" Foreground="#000000" BorderBrush="#4B7BB0"/>

                            <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#F0F0F0"/>
                            <DatePicker x:Name="EndDatePicker" Width="130" SelectedDateChanged="FilterChanged"
                                        Background="#355070" Foreground="#000000" BorderBrush="#4B7BB0"/>
                        </StackPanel>

                        <DataGrid x:Name="LoginHistoryGrid"
                                  AutoGenerateColumns="False"
                                  Margin="0,12"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True"
                                  GridLinesVisibility="Vertical"
                                  HeadersVisibility="Column"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#1A2223" Foreground="#F0F0F0" BorderBrush="#4B7BB0" RowBackground="#1A2223" AlternatingRowBackground="#2A3537">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#355070"/>
                                    <Setter Property="Foreground" Value="#F0F0F0"/>
                                    <Setter Property="BorderBrush" Value="#4B7BB0"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding SessionHistoryID}" Width="50" Foreground="#F0F0F0"/>
                                <DataGridTextColumn Header="Логин" Binding="{Binding User.Login, FallbackValue='(неизвестно)'}" Width="160" Foreground="#F0F0F0"/>
                                <DataGridTextColumn Header="IP" Binding="{Binding ip}" Width="110" Foreground="#F0F0F0"/>
                                <DataGridTextColumn Header="Время входа" Binding="{Binding LoginTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="160" Foreground="#F0F0F0"/>
                                <DataGridTextColumn Header="Время выхода" Binding="{Binding LogoutTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="160" Foreground="#F0F0F0"/>
                                <DataGridCheckBoxColumn Header="Успех" Binding="{Binding WasSuccessful}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
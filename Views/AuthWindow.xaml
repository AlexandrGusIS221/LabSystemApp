<Window x:Class="LabSystemApp.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/labapp.png"
        Title="Приложение лабораторной системы" Height="450" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#1C2526">
    <Grid Background="#1C2526">
        <Grid Margin="20" Background="#1C2526">
            <Border CornerRadius="10" Background="#2D383A" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="10">
                    <Label Content="Логин" Foreground="#FFFFFF"/>
                    <Border CornerRadius="5" BorderBrush="#4A6FA5" BorderThickness="1">
                        <TextBox x:Name="LoginInput" Height="30" TextAlignment="Justify" VerticalContentAlignment="Center"
                                 Background="#394867" Foreground="#FFFFFF" BorderThickness="0"/>
                    </Border>

                    <Label Content="Пароль" Foreground="#FFFFFF"/>
                    <Border CornerRadius="5" BorderBrush="#4A6FA5" BorderThickness="1" Background="#394867">
                        <Grid>
                            <PasswordBox x:Name="PasswordBox" Height="30" VerticalContentAlignment="Center"
                                         Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"/>
                            <TextBox x:Name="VisiblePasswordBox" Height="30" Visibility="Collapsed" VerticalContentAlignment="Center"
                                     TextAlignment="Justify" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"/>
                            <Border CornerRadius="5" Width="30" HorizontalAlignment="Right">
                                <Button Content="👁" 
                                        PreviewMouseDown="ShowPassword_Pressed" PreviewMouseUp="HidePassword_Pressed"
                                        Background="#4A6FA5" Foreground="#FFFFFF" BorderBrush="#FFFFFF"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border CornerRadius="5" Margin="0,15,0,0">
                        <Button x:Name="LoginButton" Content="Войти" Click="LoginButton_Click" Height="30"
                                Background="#4A6FA5" Foreground="#FFFFFF" BorderBrush="#FFFFFF"/>
                    </Border>

                    <TextBlock x:Name="ErrorLabel" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>

                    <!-- CAPTCHA -->
                    <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed" Margin="0,10" Background="#2D383A">
                        <TextBlock Text="CAPTCHA:" Foreground="#FFFFFF"/>
                        <Image x:Name="CaptchaImage" Width="200" Height="80" Margin="5"/>
                        <Border CornerRadius="5" BorderBrush="#4A6FA5" BorderThickness="1" Width="100">
                            <TextBox x:Name="CaptchaInput" Width="100" 
                                     Background="#394867" Foreground="#FFFFFF" BorderThickness="0"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,5" Background="#2D383A">
                            <Border CornerRadius="5">
                                <Button Content="⟳" Click="RefreshCaptcha_Click" Width="30" 
                                        Background="#4A6FA5" Foreground="#FFFFFF" BorderBrush="#FFFFFF"/>
                            </Border>
                            <Border CornerRadius="5" Margin="5,0,0,0">
                                <Button Content="OK" Click="ConfirmCaptcha_Click" Width="30" 
                                        Background="#4A6FA5" Foreground="#FFFFFF" BorderBrush="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
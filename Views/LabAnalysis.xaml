<Window x:Class="LabSystemApp.Views.LabAnalysis"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/labapp.png"
        Title="Лабораторный анализ"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed"
        Background="#1C2526">
    <!-- Black background for window -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="#1C2526">
        <!-- Black background for grid -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <DockPanel Grid.Row="0" Height="70" Background="#394867" LastChildFill="False" VerticalAlignment="Center">
            <!-- Dark blue header -->
            <Image x:Name="ProfileImage" Width="50" Height="50" Margin="15,10" Stretch="UniformToFill"/>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10,0" Background="#394867">
                <!-- Dark blue -->
                <TextBlock x:Name="FullNameText" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                <!-- White text -->
                <TextBlock x:Name="RoleText" FontSize="12" Foreground="#FFFFFF"/>
                <!-- White text -->
            </StackPanel>
            <Button Content="Выход" DockPanel.Dock="Right" Margin="15"
                    Padding="10,5" Width="150" Height="40" Click="BackToMain_Click"
                    Background="#4A6FA5" Foreground="#FFFFFF" BorderBrush="#FFFFFF"/>
            <!-- Blue button, white text -->
        </DockPanel>

        <!-- Центральная часть: только таблица -->
        <Grid Grid.Row="1" Margin="10" Background="#1C2526">
            <!-- Black -->
            <DataGrid x:Name="ordersTable"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      FontSize="14"
                      GridLinesVisibility="Vertical"
                      HeadersVisibility="Column"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#1C2526" Foreground="#FFFFFF" BorderBrush="#4A6FA5" RowBackground="#1C2526" AlternatingRowBackground="#2D383A">
                <!-- Black table -->
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#394867"/>
                        <!-- Dark blue header -->
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <!-- White header text -->
                        <Setter Property="BorderBrush" Value="#4A6FA5"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Код услуги"
                                        Binding="{Binding OrderService.ServiceID}"
                                        Width="100" Foreground="#FFFFFF"/>
                    <!-- White text -->

                    <DataGridTextColumn Header="Название"
                                        Binding="{Binding OrderService.Service.Nme}"
                                        Width="2*" Foreground="#FFFFFF"/>
                    <!-- White text, updated binding -->

                    <DataGridTextColumn Header="Штрихкод"
                                        Binding="{Binding OrderService.Barcode}"
                                        Width="2*" Foreground="#FFFFFF"/>
                    <!-- White text -->

                    <DataGridTextColumn Header="Анализатор"
                                        Binding="{Binding OrderService.Service.Analyzer.Name}"
                                        Width="1.5*" Foreground="#FFFFFF"/>
                    <!-- White text, updated binding -->

                    <DataGridTextColumn Header="Дата заказа"
                                        Binding="{Binding OrderService.Order.CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                        Width="1.3*" Foreground="#FFFFFF"/>
                    <!-- White text, updated binding -->

                    <DataGridTextColumn Header="Статус"
                                        Binding="{Binding StatusName}"
                                        Width="*" Foreground="#FFFFFF"/>
                    <!-- White text -->

                    <DataGridTemplateColumn Header="Прогресс" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ProgressBar Width="100"
                                                 Height="16"
                                                 Value="{Binding Progress}"
                                                 Maximum="100"
                                                 Minimum="0"
                                                 Background="#394867" Foreground="#4A6FA5" BorderBrush="#4A6FA5"
                                                 Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <!-- Styled ProgressBar -->
                                    <TextBlock Margin="5,0,0,0"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Text="{Binding Progress, StringFormat={}{0:F0}%}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Пациент"
                                        Binding="{Binding PatientFullName}"
                                        Width="2*" Foreground="#FFFFFF"/>
                    <!-- White text -->
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Таймер и кнопки -->
        <StackPanel Grid.Row="2" Margin="10" Background="#2D383A">
            <!-- Dark gray panel -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5" Background="#2D383A">
                <!-- Dark gray -->
                <TextBlock Text="Осталось времени:" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <!-- White text -->
                <TextBlock x:Name="TimerTextBlock" Text="02:30:00" FontWeight="Bold" Foreground="#EF4444" Margin="5,0,20,0" VerticalAlignment="Center"/>
                <!-- Red text unchanged -->
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Background="#2D383A">
                <!-- Dark gray -->
                <Button x:Name="postAnalysis"
                        Content="Отправить на анализ"
                        Click="PostAnalysis_Click"
                        Width="200" Height="40" Margin="5"
                        Background="#4A6FA5" Foreground="#FFFFFF" BorderBrush="#FFFFFF"/>
                <!-- Blue button, white text -->
                <Button x:Name="getAnalysis"
                        Content="Получить анализы"
                        Click="GetAnalysis_Click"
                        Width="200" Height="40" Margin="5"
                        Background="#4A6FA5" Foreground="#FFFFFF" BorderBrush="#FFFFFF"/>
                <!-- Blue button, white text -->
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
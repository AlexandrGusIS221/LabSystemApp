<Window x:Class="LabSystemApp.Views.AccountantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabSystemApp.Views"
        mc:Ignorable="d"
        Icon="/Assets/labapp.png"
        Title="Бухгалтерская панель" Height="460" Width="860"
        Closed="Window_Closed"
        Background="#1A2223">
    <!-- Slightly darker background -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЕЕ МЕНЮ -->
        <DockPanel Height="65" Background="#355070" LastChildFill="False" VerticalAlignment="Top">
            <!-- Slightly different blue shade -->
            <Image x:Name="ProfileImage" Width="48" Height="48" Margin="12"/>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock x:Name="FullNameText" Foreground="#F0F0F0" FontWeight="Bold" FontSize="15"/>
                <!-- Off-white text -->
                <TextBlock x:Name="RoleText" Foreground="#F0F0F0" FontSize="13"/>
            </StackPanel>
            <Button Content="Выйти" DockPanel.Dock="Right" Margin="12" Padding="12,6" Click="BackToMain_Click"
                    Background="#4B7BB0" Foreground="#F0F0F0" BorderBrush="#F0F0F0"/>
        </DockPanel>

        <!-- ФИЛЬТРЫ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12" HorizontalAlignment="Left" Background="#2A3537">
            <!-- Slightly different gray -->
            <TextBlock Text="Компания:" VerticalAlignment="Center" Margin="6,0" Foreground="#F0F0F0"/>
            <ComboBox x:Name="CompanyFilterCombo" Width="210" DisplayMemberPath="Name" SelectedValuePath="InsuranceCompanyID" Margin="6,0"
                      SelectionChanged="FilterChanged" Background="#355070" Foreground="#000000" BorderBrush="#4B7BB0"/>
            <TextBlock Text="С:" VerticalAlignment="Center" Margin="18,0,6,0" Foreground="#F0F0F0"/>
            <DatePicker x:Name="StartDatePicker" Width="130" Margin="6,0" SelectedDateChanged="FilterChanged" 
                        Background="#355070" Foreground="#000000" BorderBrush="#4B7BB0"/>
            <TextBlock Text="По:" VerticalAlignment="Center" Margin="18,0,6,0" Foreground="#F0F0F0"/>
            <DatePicker x:Name="EndDatePicker" Width="130" Margin="6,0" SelectedDateChanged="FilterChanged" 
                        Background="#355070" Foreground="#000000" BorderBrush="#4B7BB0"/>
        </StackPanel>

        <!-- ТАБЛИЦА -->
        <DataGrid x:Name="ReportsTable" Grid.Row="2" AutoGenerateColumns="False" Margin="12" IsReadOnly="True"
                  Background="#1A2223" Foreground="#F0F0F0" BorderBrush="#4B7BB0" RowBackground="#1A2223" AlternatingRowBackground="#2A3537">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#355070"/>
                    <Setter Property="Foreground" Value="#F0F0F0"/>
                    <Setter Property="BorderBrush" Value="#4B7BB0"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Заказа" Binding="{Binding OrderID}" Width="*" Foreground="#F0F0F0"/>
                <DataGridTextColumn Header="Пациент" Binding="{Binding PatientFullName}" Width="2*" Foreground="#F0F0F0"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat={}{0:0.00} ₽}" Width="*" Foreground="#F0F0F0"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="1.5*" Foreground="#F0F0F0"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- НИЖНЯЯ ПАНЕЛЬ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12" Background="#2A3537">
            <TextBlock Text="Выбор отчёта:" VerticalAlignment="Center" Margin="6,0" Foreground="#F0F0F0"/>
            <ComboBox x:Name="ReportsCombo" Width="310" DisplayMemberPath="ReportDescription" Margin="6,0,18,0" 
                      Background="#355070" Foreground="#000000" BorderBrush="#4B7BB0"/>
            <Button x:Name="SaveReportButton" Content="Экспорт отчёта" Width="160" Margin="0,0,12,0" Click="SaveReportButton_Click"
                    Background="#4B7BB0" Foreground="#F0F0F0" BorderBrush="#F0F0F0"/>
            <Button x:Name="GenerateInvoiceButton" Content="Создать отчёт" Width="210" Margin="0,0,12,0" Click="GenerateInvoiceButton_Click"
                    Background="#4B7BB0" Foreground="#F0F0F0" BorderBrush="#F0F0F0"/>
        </StackPanel>
    </Grid>
</Window>